# URL du backend ASP.NET Core Web API.
VITE_API_URL=http://localhost:5000/api

# true pour utiliser le backend réel, false pour utiliser les mocks frontend/localStorage.
VITE_USE_REAL_API=false

# Source progressive de la verticale Type matière + Déchets Fonderie.
# Valeurs autorisées : mock | api
VITE_TYPES_MATIERE_SOURCE=mock
VITE_DECHETS_SOURCE=mock
