# URL du backend ASP.NET Core Web API.
VITE_API_URL=http://localhost:5000/api

# Authentification frontend : development ou entra.
VITE_AUTH_MODE=development
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_REDIRECT_URI=http://localhost:3000/
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
VITE_ENTRA_API_SCOPE=

# =====================================================================
# Source de données par verticale fonctionnelle
# ---------------------------------------------------------------------
# Valeurs autorisées : api | mock | disabled
#
#   api      -> appels backend uniquement. Une erreur reste une erreur :
#               aucune bascule silencieuse vers les données de démonstration.
#   mock     -> données de démonstration uniquement, aucun appel réseau.
#   disabled -> aucun appel ; l'écran affiche « Fonctionnalité non disponible ».
#
# Chaque variable est facultative : sans elle, la valeur par défaut définie
# dans src/config/dataSources.ts s'applique (elle reflète l'état réel du
# backend). Une valeur inconnue déclenche un avertissement en Development et
# retombe sur cette valeur par défaut.
# =====================================================================

# --- Verticales adossées à un backend réel (persistance SQL Server) ---
VITE_AUTH_SOURCE=api
VITE_ETATS_X3_SOURCE=api
VITE_TYPES_MATIERE_SOURCE=api
VITE_DECHETS_FONDERIE_SOURCE=api
VITE_CONTROLE_POIDS_SOURCE=api
VITE_RECEPTIONS_U2_SOURCE=api
VITE_REFERENCES_FABRICATION_SOURCE=api
VITE_BILAN_U2_SOURCE=api
VITE_SORTIES_X3_SOURCE=api
VITE_HISTORIQUE_IMPORTS_SOURCE=api
VITE_INVENTAIRE_SOURCE=api
VITE_BILAN_FONDERIE_SOURCE=api
# En mode `api`, le Bilan UAP2 expose un écart EN PIÈCES : l'écran dédié
# (BilanMatiereUap2View) lit ce contrat. L'onglet UAP2 de l'écran Bilan matière
# utilise l'ancien contrat en kg et n'est disponible qu'en `mock`.
VITE_BILAN_UAP2_SOURCE=api

# --- Verticales sans endpoint backend à ce jour ---
# Les routes correspondantes n'existent pas : les laisser en `api`
# provoquerait des 404. Elles restent utilisables en démonstration.
VITE_DASHBOARD_SOURCE=mock
VITE_RAPPORTS_SOURCE=mock
VITE_ALERTES_SOURCE=mock
VITE_AUDIT_SOURCE=mock
VITE_ADMINISTRATION_SOURCE=mock

# --- Verticales désactivées ---
# Ni endpoint backend, ni donnée de démonstration crédible : afficher des
# synchronisations fictives induirait l'utilisateur en erreur.
VITE_SYNCHRONISATION_X3_SOURCE=disabled

# =====================================================================
# DÉPRÉCIÉ — ne plus utiliser
# ---------------------------------------------------------------------
# VITE_USE_REAL_API était un interrupteur global unique. Aucune de ses deux
# positions ne produisait une application cohérente : `false` masquait les
# verticales déjà branchées sur SQL Server, `true` envoyait les autres sur
# des routes 404.
#
# Il n'est conservé que comme repli lorsqu'aucune variable `VITE_*_SOURCE`
# n'est définie, et uniquement pour les verticales où les deux modes sont
# réellement disponibles. Il sera SUPPRIMÉ dans un lot ultérieur.
#
# VITE_USE_REAL_API=false
# =====================================================================
