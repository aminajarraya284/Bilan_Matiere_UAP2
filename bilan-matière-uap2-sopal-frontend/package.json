{
  "name": "sopal-bilan-matiere-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json,md}\" \"*.{js,ts,json,md}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "axios": "^1.18.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "read-excel-file": "^9.2.0",
    "vue": "^3.5.39",
    "vue-router": "^4.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
